      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|children|footer|tone|elevation|interactive|tilt|maxTilt|media|mediaAlt|state|style|key|ref|className|style|children)$/]",
