{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/content/**",
              "components/forms/**",
              "components/graphics/**",
              "components/motion/**",
              "components/spatial/**",
              "components/surfaces/**",
              "components/video/**",
              "ui_kits/social/**",
              "ui_kits/spatial/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Barlow Condensed|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: Barlow Condensed, Nunito Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmbientGlow'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|tone|intensity|pulse|style|className|key|ref|className|style|children)$/]",
        "message": "<AmbientGlow> doesn't accept that prop. Declared props: size, tone, intensity, pulse, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AmbientGlow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:warm|blue|neon)$/]",
        "message": "<AmbientGlow> tone must be one of 'warm' | 'blue' | 'neon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnimatedMascot'] > JSXAttribute > JSXIdentifier[name!=/^(?:base|size|pointer|ambient|glow|hop|children|style|className|key|ref|className|style|children)$/]",
        "message": "<AnimatedMascot> doesn't accept that prop. Declared props: base, size, pointer, ambient, glow, hop, children, style, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|arrow|block|state|glow|loading|loadingLabel|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, arrow, block, state, glow, loading, loadingLabel, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|cream)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Button> size must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:hover|active|focus)$/]",
        "message": "<Button> state must be one of 'hover' | 'active' | 'focus'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='glow'] > Literal[value!=/^(?:warm|neon|none)$/]",
        "message": "<Button> glow must be one of 'warm' | 'neon' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaptionBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|style|key|ref|className|style|children)$/]",
        "message": "<CaptionBlock> doesn't accept that prop. Declared props: children, size, style."
